// Tracked wrapper so a clean checkout (no local prefix) still generates and builds under the
// upstream identifiers. Referenced from project.yml's top-level (project-wide) configFiles, so
// every target picks it up automatically — including targets that also carry their own separate
// xcconfig (e.g. Strand/Oura/OuraConfig.xcconfig), since Xcode layers project-level xcconfig
// beneath target-level xcconfig rather than one replacing the other. Feeds
// PRODUCT_BUNDLE_IDENTIFIER, APP_GROUP_ID, and WKCompanionAppBundleIdentifier across all six
// targets (see project.yml's use of $(BUNDLE_ID_PREFIX)).
//
// BundleIdSecrets.xcconfig is gitignored and user-created (template:
// BundleIdSecrets.example.xcconfig). Set BUNDLE_ID_PREFIX there when building under your own
// Apple ID / device so this build's bundle id, App Group, and watch companion pairing don't
// collide with an installed copy of the official com.noopapp build.
BUNDLE_ID_PREFIX = com.noopapp
// Empty by default: CODE_SIGN_STYLE is Automatic and macOS ad-hoc builds (see docs/BUILD.md) need
// no team at all. Set DEVELOPMENT_TEAM in BundleIdSecrets.xcconfig to run on a physical iPhone or
// to stop Xcode from asking you to reselect a team after every `xcodegen generate`.
DEVELOPMENT_TEAM =
#include? "BundleIdSecrets.xcconfig"

// MARK: - WHOOP cloud credentials
//
// The Apple twin of the Android lane's `android/local.properties` WHOOP_* keys. WhoopSecrets.xcconfig
// is gitignored and user-created (template: WhoopSecrets.example.xcconfig); with it absent every
// $(WHOOP_*) key below resolves to an empty string, `WhoopCredentials.fromBundle` is nil, and the app
// simply does not offer the connection. NOT CONFIGURED IS A FIRST-CLASS STATE — nothing throws.
//
// Defaults are declared HERE rather than only in the secrets file so a clean checkout resolves them
// to empty rather than leaving the literal "$(WHOOP_CLIENT_ID)" in the built Info.plist.
WHOOP_CLIENT_ID =
WHOOP_CLIENT_SECRET =
// .xcconfig treats // as a start-of-comment ANYWHERE on a line, so the empty macro expansion $()
// breaks up the "//" token without changing the resolved string — it is still exactly
// noop://whoop-oauth at build time, matching the Android redirect byte for byte.
WHOOP_REDIRECT_URI = noop:/$()/whoop-oauth
#include? "WhoopSecrets.xcconfig"
